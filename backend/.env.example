MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Fernet key used only by the backend to encrypt saved database passwords.
CONNECTION_ENCRYPTION_KEY=


# Gemini AI (keep this backend-only; never expose it to the browser).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=20


# Free local AI via Ollama (default).
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
AI_TIMEOUT_SECONDS=60

