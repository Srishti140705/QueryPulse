# PostgreSQL application database (used by Docker Compose)
POSTGRES_DB=querypulse
POSTGRES_USER=querypulse
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Backend security and public URLs
JWT_SECRET_KEY=replace-with-a-long-random-secret
CONNECTION_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
JWT_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Browser-visible API address baked into the production frontend image
VITE_API_URL=http://localhost:8000

# Optional email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# AI provider: use Ollama on the Windows host by default
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:3b
AI_TIMEOUT_SECONDS=60

# Optional Gemini alternative (keep empty when using Ollama)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=20
